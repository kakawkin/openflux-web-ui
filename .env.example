# ==============================================================================
# OpenFlux Web UI - Environment Variables
# ==============================================================================

# Database and configuration paths
OPENFLUX_DB_PATH=/etc/openflux/panel.db
OPENFLUX_CONF_DIR=/etc/openflux/users

# Local binding (Uvicorn)
OPENFLUX_HOST=127.0.0.1
OPENFLUX_PORT=8000

# Public server host (IP or domain used for client .conf and openflux:// links)
OPENFLUX_SERVER_HOST=your-server-ip-or-domain.com

# Initial admin password (used only on first startup if not already set)
OPENFLUX_ADMIN_PASSWORD=admin123
