# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure shell scripts and systemd units always use LF
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
bin/* text eol=lf
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
bin/openflux-linux binary
