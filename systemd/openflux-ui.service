[Unit]
Description=OpenFlux Web UI Management Panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openflux-web-ui
ExecStart=/opt/openflux-web-ui/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
LimitNOFILE=65535
Environment="OPENFLUX_DB_PATH=/etc/openflux/panel.db"
Environment="OPENFLUX_CONF_DIR=/etc/openflux/users"

[Install]
WantedBy=multi-user.target
